---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
import Header from "@/components/sections/Header/Header.astro";
import LogoImg from "@/assets/images/logo.webp";
import { ClientRouter } from "astro:transitions";
import Loading from "@/components/Loading.astro";

import "@/styles/global.css";
import Footer from '@/components/sections/Footer/Footer.astro';
import { getBusinessInfo } from '@/lib/getBusinessInfo';

const {
  title = "La cocina de Vero",
  description = "Descubre los mejores platos caseros para llevar en Torrox, Málaga. Calidad, sabor y tradición en cada bocado.",
  keywords = "comida para llevar, Torrox, Málaga, platos caseros, comida tradicional, restaurantes, restaurantes en Torrox costa, comida urbana",
  author = "La Cocina de Vero",
  ogTitle,
  ogDescription,
  ogUrl,
  ogImage,
  twitterTitle,
  twitterDescription,
  twitterImage
} = Astro.props;
const lang = Astro.currentLocale;


// Business details come from the CMS so the structured data can't drift out
// of sync with what the footer and about page show.
const business = await getBusinessInfo((lang ?? 'es') as "es" | "en" | "de");

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "La cocina de Vero",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": business.address,
    "addressLocality": "Torrox",
    "addressRegion": "Málaga",
    "addressCountry": "ES"
  },
  "telephone": business.phone,
  "url": "https://lacocinadevero.es/",
  "servesCuisine": ["Comida casera", "Platos tradicionales", "Comida para llevar", "Comida urbana"],
  "priceRange": "€",
  "openingHours": business.openingHoursSchema
});

---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={author} />
  <script async="true" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB0hp4j0dK93rmrFNjJECRJghuod_7Hafk&callback=console.debug&libraries=maps,marker&v=beta">
  </script>
  <title>{title}</title>
    
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href={LogoImg.src} as="image" />
  <link rel="preload" href={"/img/placeholder-image.webp"} as="image" />
  <link rel="alternate" href="https://lacocinadevero.es/es/" hreflang="es" />
  <link rel="alternate" href="https://lacocinadevero.es/en/" hreflang="en" />
  <link rel="alternate" href="https://lacocinadevero.es/de/" hreflang="de" />
  <link rel="alternate" href="https://lacocinadevero.es/es/" hreflang="x-default" />

  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={ogUrl ?? Astro.url} />
  <meta property="og:image" content={ogImage ?? LogoImg.src} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:site_name" content={author} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={author} />
  <meta name="twitter:title" content={twitterTitle ?? title} />
  <meta name="twitter:description" content={twitterDescription ?? description} />
  <meta name="twitter:image" content={twitterImage ?? LogoImg.src} />

    <script type="javascript">
      const $html = document.querySelector("html");
      const lang = localStorage.getItem("lang");
      if (lang) {
        $html.lang = lang;
      }
    </script>
    <ClientRouter />

    <script type="application/ld+json" set:html={jsonLd} />

  </head>
  <body>
    <main class="flex flex-col min-h-screen">
      <Header />
      <div class="grow">
        <slot />
      </div>
      <Footer />
    </main>
    <Loading />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
