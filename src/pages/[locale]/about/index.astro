---
import Map from "@/components/Map/Map.astro";
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/lib/i18n/useTranslations";
import { getBusinessInfo } from "@/lib/getBusinessInfo";

const lang = Astro.currentLocale as "es" | "en" | "de";
const t = useTranslations(lang);
const business = await getBusinessInfo(lang);

export async function getStaticPaths() {
	return [
		{ params: { locale: "en" } },
		{ params: { locale: "de" } },
        { params: { locale: "es" } },
	];
}

// On demand + ISR: this page shows the phone/address, which come from the CMS.
export const prerender = false;
---

<Layout title={`${t("about.title")} - La cocina de Vero`}>
    <section class="max-w-6xl gap-8 mx-auto px-4 mt-10 flex flex-col md:flex-row mb-8">
        <div class="flex-1/2">
            <h1 class="text-2xl font-semibold text-balance mb-3">{t("about.title")}</h1>
            <p class="text-pretty mb-3">{t("about.experience")}</p>
            <p class="text-pretty mb-6">{t("about.contact")}</p>

            <div class="bg-neutral/50 rounded-xl p-4 flex flex-col gap-2">
                <p>{t("about.telephone")}: <a href={`tel:${business.phoneLink}`} class="text-blue-700 underline underline-offset-2">{business.phone}</a></p>
                <p>{t("about.address")}: <a href={business.mapsUrl} target="_blank" class="text-blue-700 underline underline-offset-2">{business.address}</a></p>
            </div>
        </div>
        <div class="flex-1/2">
            <Map height="400px" width="100%" borderRadius="12px"/>
        </div>
    </section>
</Layout>